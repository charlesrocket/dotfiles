set encoding=utf8
set ffs=unix,mac,dos

set mouse=a

set shiftwidth=4
set softtabstop=4
set tabstop=4
set expandtab
set smarttab

set number
set autoread
set ruler

set nobackup
set nowb
set noswapfile

set wildignore+=*/.git/*,*/.hg/*,*/.svn/*,*/.DS_Store

syntax on
colorscheme default
filetype plugin indent on

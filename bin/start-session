#!/bin/sh

cd ~ || exit

timer=2

if [ "$1" = mango ]; then
	while [ $timer -gt 0 ]; do
		printf "\rStarting \033[35;40;1mMango\033[m in %d" ${timer}
		sleep 1
		timer=$((timer - 1))
	done

	hpid=$(/bin/pgrep -n mango)

	if test -z "$hpid"; then
		exec dbus-launch ck-launch-session mango
	else
		printf "\rMango is already running!\nPID %d\n" "${hpid}"
	fi
elif [ "$1" = "kde" ]; then
	while [ $timer -gt 0 ]; do
		printf "\rStarting \033[33;40;1mKDE\033[m in %d" ${timer}
		sleep 1
		timer=$((timer - 1))
	done

	hpid=$(/bin/pgrep -n plasmashell)

	if test -z "$hpid"; then
		exec dbus-launch ck-launch-session startplasma-wayland
	else
		printf "\rKDE is already running!\nPID %d\n" "${hpid}"
	fi
elif [ "$1" = "sway" ]; then
	while [ $timer -gt 0 ]; do
		printf "\rStarting \033[34;40;1mSway\033[m in %d" ${timer}
		sleep 1
		timer=$((timer - 1))
	done

	hpid=$(/bin/pgrep -n sway)

	if test -z "$hpid"; then
		exec dbus-launch ck-launch-session sway
	else
		printf "\rSway is already running!\nPID %d\n" "${hpid}"
	fi
elif [ "$1" = "hypr" ]; then
	while [ $timer -gt 0 ]; do
		printf "\rStarting \033[36;40;1mHyprland\033[m in %d" ${timer}
		sleep 1
		timer=$((timer - 1))
	done

	hpid=$(/bin/pgrep -n Hyprland)

	if test -z "$hpid"; then
		exec dbus-launch ck-launch-session start-hyprland
	else
		printf "\rHyprland is already running!\nPID %d\n" "${hpid}"
	fi
else
	echo "Expected mango|kde|sway|hypr"
	exit 1
fi

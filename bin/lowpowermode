#!/bin/sh
# Toggle low power mode

if [ "$1" = 0 ]; then
	STATUS="disabled"

	quickshell ipc call bar setEcoMode false
	hyprctl reload --quiet
	notify-send -u low "LOW POWER MODE" "OFF" --icon=battery-full-symbolic
elif [ "$1" = 1 ]; then
	STATUS="enabled"
	quickshell ipc call bar setEcoMode true
	hyprctl --quiet --batch "\
		keyword animations:enabled false;\
		keyword decoration:blur:enabled false;\
		keyword decoration:shadow:enabled false;"

	notify-send -u low "LOW POWER MODE" "ON" --icon=battery-caution-symbolic
else
	echo "Expected '0' or '1'"
	exit 1
fi

printf """\033[93;40;1mL O W P O W E R\
\033[91;1m - \033[93;40;1mM O D E\033[36;1m . \
\033[37m%s\033[0m\n" "${STATUS}"

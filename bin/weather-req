#!/bin/sh

geo=$(curl -s 'http://ip-api.com/json/')
ip=$(echo "$geo" | jq '.query')
lat=$(echo "$geo" | jq '.lat')
lon=$(echo "$geo" | jq '.lon')

weather=$(curl -s "https://api.open-meteo.com/v1/forecast?\
latitude=$lat&longitude=$lon&current_weather=true")

is_day=$(echo "$weather" | jq '.current_weather.is_day')
code=$(echo "$weather" | jq '.current_weather.weathercode')
temp=$(echo "$weather" | jq '.current_weather.temperature')

case $code in
0) icon=$([ "$is_day" -eq 1 ] && printf "" || printf "󰖔") ;;
1 | 2 | 3) icon=$([ "$is_day" -eq 1 ] && printf "󰖕" || printf "󰼱") ;;
45 | 48) icon="󰱋" ;;
51 | 53 | 55 | 56 | 57) icon="" ;;
61 | 63 | 65 | 66 | 67) icon="" ;;
71 | 73 | 75 | 77) icon="󰜗" ;;
80 | 81 | 82) icon="" ;;
85 | 86) icon="" ;;
95) icon="" ;;
96 | 99) icon="󰖒" ;;
*) icon="󱣶" ;;
esac

echo "{\"conditions\": \"$icon\", \"temp\": $temp, \"ip\": $ip}"

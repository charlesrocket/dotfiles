#!/bin/sh

iface="$1"

if ! ifconfig "$iface" >/dev/null 2>&1; then
	echo "Error: Interface $iface does not exist!"
	exit 1
fi

get_stats() {
	netstat -bI "$iface" 2>/dev/null | awk -v iface="$iface" '
        $1 == iface && NF >= 11 {
            print $8, $11
            exit
        }
    '
}

stats1=$(get_stats)
if [ -z "$stats1" ]; then
	echo "Error: Could not read stats for $iface"
	exit 1
fi

sleep 1

stats2=$(get_stats)
if [ -z "$stats2" ]; then
	echo "Error: Could not read stats for $iface"
	exit 1
fi

echo "$stats1" "$stats2" | awk '{
    in_bytes1 = $1
    out_bytes1 = $2
    in_bytes2 = $3
    out_bytes2 = $4

    if (in_bytes1 == "" || out_bytes1 == "" || in_bytes2 == "" || out_bytes2 == "") {
        print "Error: Invalid stats format" > "/dev/stderr"
        exit 1
    }

    in_speed = in_bytes2 - in_bytes1
    out_speed = out_bytes2 - out_bytes1

    if (in_speed < 0) in_speed = 0
    if (out_speed < 0) out_speed = 0

    if (in_speed >= 1073741824)
        in_human = sprintf("%.2f GB/s", in_speed/1073741824)
    else if (in_speed >= 1048576)
        in_human = sprintf("%.2f MB/s", in_speed/1048576)
    else if (in_speed >= 1024)
        in_human = sprintf("%.2f KB/s", in_speed/1024)
    else
        in_human = sprintf("%d B/s", in_speed)

    if (out_speed >= 1073741824)
        out_human = sprintf("%.2f GB/s", out_speed/1073741824)
    else if (out_speed >= 1048576)
        out_human = sprintf("%.2f MB/s", out_speed/1048576)
    else if (out_speed >= 1024)
        out_human = sprintf("%.2f KB/s", out_speed/1024)
    else
        out_human = sprintf("%d B/s", out_speed)

    print " " in_human "  " out_human
}'

{
  "git_panel": {
    "fallback_branch_name": "trunk"
  },
  "window_decorations": "client",
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_nav_history_buttons": true
  },
  "colorize_brackets": false,
  "inlay_hints": {
    "enabled": false
  },
  "show_whitespaces": "selection",
  "toolbar": {
    "code_actions": false,
    "agent_review": false
  },
  "minimap": {
    "show": "never"
  },
  "gutter": {
    "folds": true,
    "breakpoints": true,
    "runnables": true
  },
  "sticky_scroll": {
    "enabled": false
  },
  "show_wrap_guides": true,
  "auto_update": false,
  "collaboration_panel": {
    "button": false,
  },
  "languages": {
    "Zig": {
      "enable_language_server": false,
      "tasks": {
        "enabled": true,
      },
    },
  },
  "agent": {
    "button": false,
    "model_parameters": [],
    "enable_feedback": false,
  },
  "rounded_selection": true,
  "current_line_highlight": "all",
  "cursor_blink": false,
  "on_last_window_closed": "quit_app",
  "buffer_line_height": "standard",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "RobotoMono Nerd Font Mono",
  "disable_ai": true,
  "calls": {
    "mute_on_join": true,
  },
  "git": {
    "inline_blame": {
      "delay_ms": 1100,
      "show_commit_summary": true,
    },
  },
  "project_panel": {
    "sticky_scroll": true,
    "bold_folder_labels": false,
    "git_status": true,
    "hide_root": true,
    "entry_spacing": "comfortable",
    "hide_gitignore": false,
  },
  "bottom_dock_layout": "contained",
  "tabs": {
    "activate_on_close": "neighbour",
    "close_position": "left",
    "file_icons": false,
    "git_status": true,
  },
  "title_bar": {
    "show_user_menu": false,
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_menus": false,
    "show_branch_icon": true,
  },
  "status_bar": {
    "active_encoding_button": "enabled",
    "cursor_position_button": true,
  },
  "indent_guides": {
    "background_coloring": "disabled",
  },
  "scrollbar": {
    "show": "auto",
  },
  "hover_popover_delay": 1000,
  "edit_predictions": {
    "mode": "subtle",
  },
  "show_edit_predictions": false,
  "cursor_shape": "bar",
  "when_closing_with_no_tabs": "close_window",
  "icon_theme": "Zed (Default)",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "Atom",
  "ui_font_size": 15.0,
  "buffer_font_size": 13.0,
  "theme": "One Dark - Darkened",
}

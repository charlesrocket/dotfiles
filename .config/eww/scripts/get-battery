#!/usr/local/bin/perl

use strict;
use warnings;

my $apm = `apm`;
my ($source, $time, $message, $charge, $label, $online);

for my $line (split /\n/, $apm) {
    if ($line =~ /^AC Line status:\s*(on-line)/i) {
        if ($1 eq "on-line") { $online = 1; }
    }
    if ($line =~ /^Battery [Ss]tatus:\s*(charging)/i) {
        if ($1 eq "charging") { $message = "batt-charging"; }
    }
    if ($line =~ /^Number of batteries:\s*(\d+)/i) {
        if ($1 != 0) { $source = "battery"; }
    }
    if ($line =~ /^Remaining battery life:\s*(\d+)%/ && !defined $charge) {
        $charge = $1;
    }
    if ($line =~ /^Remaining battery time:\s*(\S+)/ && !defined $time) {
        $time = $1;
    }
}

$charge = 0 unless defined $charge;
$time = "" unless defined $time;

if ($charge == 100) {
    $message = ($online ? "batt-charged" : "");
    $label = ($online ? "󰂅" : "󰁹");
} elsif ($charge >= 90) {
    $message = ($online ? "batt-charged" : "");
    $label = ($online ? "󰂋" : "󰂂");
} elsif ($charge >= 80) {
    $message = ($online ? "batt-charged" : "");
    $label = ($online ? "󰂊" : "󰂁");
} elsif ($charge >= 70) {
    $label = ($online ? "󰢞" : "󰂀");
} elsif ($charge >= 60) {
    $label = ($online ? "󰂉" : "󰁿");
} elsif ($charge >= 50) {
    $label = ($online ? "󰢝" : "󰁾");
} elsif ($charge >= 40) {
    $label = ($online ? "󰂈" : "󰁽");
} elsif ($charge >= 30) {
    $label = ($online ? "󰂇" : "󰁼");
} elsif ($charge >= 20) {
    $message = "batt-critical" unless $online;
    $label = ($online ? "󰂆" : "󰁻");
} else {
    $message = "batt-critical" unless $online;
    $label = ($online ? "󰢜" : "󰁺");
    if ($time ne "unknown" && $time ne "") {
        system("notify-send",
               "-u",
               "critical",
               "--icon", "battery-caution-symbolic",
               "-t", "45000",
               "Battery level",
               $charge . "%"
            );
    }
}

if ($time eq "unknown") { $time = ""; }

my $time_display = $time;
if ($time_display ne "") {
    $time_display .= " ($charge%)";
} else {
    $time_display = "$charge%";
}

print
    '{"source":"' . (defined $source ? $source : '') .
    '","time":"' . $time_display .
    '","label":"' . (defined $label ? $label : '󰄌') .
    '","message":"' . (defined $message ? $message : '') .
    '"}';

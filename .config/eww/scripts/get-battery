#!/usr/local/bin/perl

use strict;
use warnings;

my $apm = `apm`;
my ($source, $time, $message, $charge, $label);

for my $line (split /\n/, $apm) {
    if ($line =~ /^AC Line status:\s*(on-line)/i) {
        if ($1 eq "on-line") { $message = "batt-online"; }
    }
    if ($line =~ /^Battery status:\s*(charging)/i) {
        if ($1 eq "charging") { $message = "batt-charging"; }
    }
    if ($line =~ /^Number of batteries:\s*(\d+)/i) {
        if ($1 != 0) { $source = "battery"; }
    }
    if ($line =~ /^Remaining battery life:\s*(\d+)%/) { $charge = $1; }
    if ($line =~ /^Remaining battery time:\s*(\S+)/) { $time = $1; }
}

if ($charge == 100) {
    $message = "batt-charged";
    $label = "󰁹";
} elsif ($charge >= 80) {
    $message = "batt-charged";
    $label = "󰂁";
} elsif ($charge >= 70) {
    $label = "󰂀";
} elsif ($charge >= 60) {
    $label = "󰁿";
} elsif ($charge >= 50) {
    $label = "󰁾";
} elsif ($charge >= 40) {
    $label = "󰁽";
} elsif ($charge <= 30) {
    $message = "batt-critical";
    $label = "󰁼";

    if ($time ne "unknown") {
        system("notify-send",
               "-u",
               "critical",
               "--icon", "battery-caution-symbolic",
               "-t", "45000",
               "Battery" . " level",
               $charge . "%"
            );
    }
}

if ($time eq "unknown") { $time = "$charge% charged"; }

print
    '{"source":"' . $source .
    '","time":"' . $time .
    '","label":"' . (defined $label ? $label : '󰄌') .
    '","message":"' . (defined $message ? $message : '') .
    '"}';

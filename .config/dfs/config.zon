.{
    .repository = "https://github.com/charlesrocket/dotfiles",
    .source = "$HOME/src/dotfiles",
    .target = "$HOME",
    .logging = false,
    .notifications = false,
    .watcher = .auto,
    .ignore_list = .{},
    .tray = .{
        .enabled = true,
        .icon = .bright,
        .menu_icons = true,
    },
}

#!/bin/sh

get_window_title() {
	window_event="$1"
	window_title=""

	if echo "$window_event" | jq -e 'has("WindowsChanged")' >/dev/null 2>&1; then
		window_title=$(echo "$event" | jq -r '.WindowsChanged.windows[]? | select(.is_focused == true) | .title // ""')
	elif echo "$event" | jq -e 'has("WindowOpenedOrChanged")' >/dev/null 2>&1; then
		window_title=$(echo "$event" | jq -r '.WindowOpenedOrChanged.window | select(.is_focused == true) | .title // ""')
	fi

	echo "$window_title"
}

get_current_workspace() {
	workspace_event="$1"
	workspace_current=""

	if echo "$workspace_event" | jq -e 'has("WorkspacesChanged")' >/dev/null 2>&1; then
		workspace_current=$(echo "$workspace_event" | jq -r '.WorkspacesChanged.workspaces[]? | select(.is_focused == true) | .id // ""')
	fi

	if [ -z "$workspace_current" ] && echo "$workspace_event" | jq -e 'has("WindowsChanged")' >/dev/null 2>&1; then
		workspace_current=$(echo "$event" | jq -r '.WindowsChanged.windows[]? | select(.is_focused == true) | .workspace_id // ""')
	fi

	echo "$workspace_current"
}

create_workspace_icons() {
	cat <<'EOF'
[
  {"id": "1", "name": "\ueb44", "windows": 0},
  {"id": "2", "name": "\uf489", "windows": 0},
  {"id": "3", "name": "\uf488", "windows": 0},
  {"id": "4", "name": "\uf121", "windows": 0},
  {"id": "5", "name": "\uf044", "windows": 0},
  {"id": "6", "name": "\udb80\ude55", "windows": 0},
  {"id": "7", "name": "\uf42f", "windows": 0},
  {"id": "8", "name": "\ue238", "windows": 0},
  {"id": "9", "name": "\uf0c3", "windows": 0},
  {"id": "10", "name": "\uf1b3", "windows": 0}
]
EOF
}

update_workspaces() {
	upd_event="$1"
	upd_workspaces="$2"

	if echo "$upd_event" | jq -e 'has("WorkspacesChanged")' >/dev/null 2>&1; then
		echo "$upd_event" | jq -c '.WorkspacesChanged.workspaces | map({
            id: (.id | tostring),
            name: (
                if .id == 1 then "\ueb44"
                elif .id == 2 then "\uf489" 
                elif .id == 3 then "\uf488"
                elif .id == 4 then "\uf121"
                elif .id == 5 then "\uf044"
                elif .id == 6 then "\udb80\ude55"
                elif .id == 7 then "\uf42f"
                elif .id == 8 then "\ue238"
                elif .id == 9 then "\uf0c3"
                elif .id == 10 then "\uf1b3"
                else "" end
            ),
            windows: (if .active_window_id != null and .active_window_id != "" then 1 else 0 end)
        })' 2>/dev/null || echo "$upd_workspaces"
	else
		echo "$upd_workspaces"
	fi
}

output_json() {
	out_window_title="$1"
	out_workspaces="$2"
	out_current_workspace="$3"

	echo "{\"window_title\":\"$out_window_title\",\"workspaces\":$out_workspaces,\"current_workspace\":\"$out_current_workspace\"}"
}

window_title=""
workspaces=$(create_workspace_icons)
current_workspace="1"

output_json "$window_title" "$workspaces" "$current_workspace"

niri msg --json event-stream | while read -r event || [ -n "$event" ]; do
	changed=false

	new_window_title=$(get_window_title "$event")
	if [ -n "$new_window_title" ] && [ "$new_window_title" != "$window_title" ]; then
		window_title="$new_window_title"
		changed=true
	fi

	new_current_workspace=$(get_current_workspace "$event")
	if [ -n "$new_current_workspace" ] && [ "$new_current_workspace" != "$current_workspace" ]; then
		current_workspace="$new_current_workspace"
		changed=true
	fi

	new_workspaces=$(update_workspaces "$event" "$workspaces")
	if [ "$new_workspaces" != "$workspaces" ]; then
		workspaces="$new_workspaces"
		changed=true
	fi

	if [ "$changed" = true ]; then
		output_json "$window_title" "$workspaces" "$current_workspace"
	fi
done
